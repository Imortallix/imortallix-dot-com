---
interface Props {
  slug: string;
  title: string;
  blurb: string;
  tech: string[];
  status: string;
}

const { slug, title, blurb, tech, status } = Astro.props;
---

<a class="card" href={`/projects/${slug}/`}>
  <span class="status-badge">{status}</span>
  <h3>{title}</h3>
  <p>{blurb}</p>
  <ul class="tech-tags">
    {tech.map((t) => <li>{t}</li>)}
  </ul>
</a>
