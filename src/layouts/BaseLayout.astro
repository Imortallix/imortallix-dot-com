---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Gavin Frings' personal project showcase." } = Astro.props;
const pageTitle = title === 'Imortallix' ? title : `${title} · Imortallix`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrapper">
        <a class="brand" href="/">Imortallix</a>
        <nav>
          <a href="/projects/">Projects</a>
          <a href="/notes/">Notes</a>
        </nav>
      </div>
    </header>

    <main id="main" class="wrapper">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrapper">
        <a href="https://github.com/Imortallix">GitHub</a>
        <a href="mailto:gavin.frings@gmail.com">Email</a>
      </div>
    </footer>
  </body>
</html>
